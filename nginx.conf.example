# Nginx 反向代理配置示例
# 用于在源站服务器上配置HTTPS和反向代理

server {
    listen 80;
    server_name cn.yourdomain.com;  # 修改为你的域名
    
    # HTTP自动跳转HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cn.yourdomain.com;  # 修改为你的域名
    
    # SSL证书配置（使用Cloudflare Origin Certificate或Let's Encrypt）
    ssl_certificate /path/to/cert.pem;
    ssl_certificate_key /path/to/key.pem;
    
    # SSL优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # 日志
    access_log /var/log/nginx/biliurl_access.log;
    error_log /var/log/nginx/biliurl_error.log;
    
    # 反向代理到Python应用
    location / {
        proxy_pass http://127.0.0.1:7997;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时配置（媒体流可能需要更长时间）
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 禁用缓冲（流媒体需要）
        proxy_buffering off;
        proxy_request_buffering off;
    }
    
    # 静态文件直接由Nginx提供（可选，提升性能）
    location /static/ {
        alias /path/to/biliurl/ncm/api/static/;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }
    
    # 健康检查端点（不记录日志）
    location /health {
        proxy_pass http://127.0.0.1:7997;
        access_log off;
    }
}
